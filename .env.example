# Telegram credentials — https://my.telegram.org/apps and @BotFather
BOT_TOKEN=
API_ID=
API_HASH=

# MongoDB (optional — with no URI the bot runs but skips upload logging)
MONGO_URI=
DB_NAME=unzip_bot

# Telegram user IDs allowed into the admin panel (/admin), comma-separated.
# Send /start to @userinfobot to find yours.
ADMIN_IDS=

# Optional default dump chat (group/channel id, e.g. -1001234567890) for
# extracted files. Override at runtime with /setdump <chat_id> or /unsetdump.
# Leave empty to send files back to the user.
DUMP_CHAT_ID=

# Health server port (Railway/Heroku inject PORT automatically)
PORT=8000

# Where temp archives/extractions live
TEMP_ROOT=./temp

# --- Optional tuning ---
# MAX_FILE_SIZE=2097152000
# MAX_ARCHIVE_SIZE=5368709120
# MAX_TOTAL_EXTRACTED=10737418240
# SESSION_TTL=3600
# TRANSFER_CONCURRENCY=1000
# WORKERS=64
# UPLOAD_INTERVAL=0.5
# STATUS_EDIT_INTERVAL=4
# RICH_UI=1
