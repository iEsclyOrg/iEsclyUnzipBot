# Telegram credentials — https://my.telegram.org/apps and @BotFather
BOT_TOKEN=
API_ID=
API_HASH=

# MongoDB (optional — with no URI the bot runs but skips upload logging)
MONGO_URI=
DB_NAME=unzip_bot

# Health server port (Railway/Heroku inject PORT automatically)
PORT=8000

# Where temp archives/extractions live
TEMP_ROOT=./temp

