# Never bake secrets or a live login session into the image.
.env
.env.*
!.env.example
*.session
*.session-journal

# Per-user extraction workspace (large, recreated at runtime).
temp/

# Git history and local editor/OS clutter.
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python bytecode / caches.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Dev-only scratch tests.
_scratch_test*.py
