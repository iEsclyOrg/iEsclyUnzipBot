{
  "name": "UnzipBot",
  "description": "Telegram bot to extract zip, rar, 7z, tar archives and upload files via MTProto with 2GB support.",
  "repository": "https://github.com/yourusername/unzip-bot",
  "logo": "https://telegram.org/img/t_logo.png",
  "keywords": [
    "telegram",
    "bot",
    "unzip",
    "extract",
    "archive"
  ],
  "stack": "container",
  "env": {
    "BOT_TOKEN": {
      "description": "Your Telegram bot token from @BotFather",
      "required": true
    },
    "API_ID": {
      "description": "Your Telegram API ID from https://my.telegram.org/apps",
      "required": true
    },
    "API_HASH": {
      "description": "Your Telegram API hash from https://my.telegram.org/apps",
      "required": true
    },
    "MONGO_URI": {
      "description": "MongoDB connection URI. Use MongoDB Atlas or Heroku MongoDB add-on.",
      "required": true
    },
    "DB_NAME": {
      "description": "MongoDB database name",
      "value": "unzip_bot",
      "required": true
    },
    "MAX_FILE_SIZE": {
      "description": "Max file size before splitting (bytes)",
      "value": "2147483648",
      "required": false
    },
    "MAX_ARCHIVE_SIZE": {
      "description": "Max archive size (bytes)",
      "value": "5368709120",
      "required": false
    },
    "MAX_TOTAL_EXTRACTED": {
      "description": "Max total extracted size (bytes)",
      "value": "10737418240",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
